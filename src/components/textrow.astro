---
interface Props {
    insights: string;
}

const { insights } = Astro.props;
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-x-5 pt-5 pb-28">
    <div>
    </div>

    <div class="flex flex-col gap-2 md:px-5">
        <p class="text-sm uppercase opacity-50">Key Insights</p>
        <p class="text-lg leading-normal max-w-lg">{insights}</p>
    </div>
    
</div>