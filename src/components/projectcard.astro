---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    title: string;
    image: ImageMetadata;
    type: string;
    year: string;
    slug: string;
}

const { title, image, type, year, slug } = Astro.props;
---

<a href={`/projects/${slug}`}>
    <div class="flex flex-col gap-2.5">

        <div class="bg-background-card rounded-xl border border-border-quite py-14">
            <Image 
                src={image} 
                alt={title} 
                loading={"eager"}
                transition:name={`project-image-${slug}`}
                class="w-4/5 aspect-3/2 object-cover mx-auto rounded-sm"
                widths={[800, 1200, 1600, 2000, 2400, 3000]}
                sizes="(max-width: 768px) 100vw, 50vw"
            />
        </div>
        

        <div class="flex flex-col gap-0.5 px-1">
            <div class="flex flex-row justify-between">
                <h3 class="text-sm font-medium">{title}</h3>
                <p class="text-sm font-normal uppercase">{year}</p>
            </div>
            <p class="text-sm text-text-muted">{type}</p>
        </div>

    </div>

</a>


    
    

