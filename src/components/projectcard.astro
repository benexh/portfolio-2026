---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
    title: string;
    image: ImageMetadata;
    type: string;
    year: string;
    slug: string;
}

const { title, image, type, year, slug } = Astro.props;
---

<a href={`/projects/${slug}`}>
    <div class="flex flex-col gap-2.5">
        <Image 
        src={image} 
        alt={title} 
        loading={"eager"}
        class="w-full aspect-square object-cover"
        widths={[800, 1200, 1600, 2000, 2400, 3000]}
        sizes="(max-width: 768px) 100vw, 50vw"
        />

        <div class="flex flex-col gap-0.5">
            <div class="flex flex-row justify-between">
                <h3 class="text-sm font-normal uppercase">{title}</h3>
                <p class="text-sm font-normal uppercase">{year}</p>
            </div>
            <p class="text-sm opacity-50">{type}</p>
        </div>

    </div>

</a>


    
    

