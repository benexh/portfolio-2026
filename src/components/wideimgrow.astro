---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
    image?: ImageMetadata;
    desc: string;
}

const {image, desc } = Astro.props
---

<div class="grid grid-cols-1 pt-5 pb-40">
    {image && (
       <div class="flex flex-col gap-1">
        <Image 
        src={image} 
        alt="" 
        class="w-full aspect-2/1 object-cover"
        widths={[800, 1200, 1600, 2000, 2400, 3000]}
        sizes="(max-width: 768px) 100vw, 100vw"
        />
        <p class="text-sm uppercase opacity-50">{desc}</p>
    </div> 
    )}
    
</div>