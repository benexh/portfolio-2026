---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
    image1?: ImageMetadata;
    desc1: string;
    image2?: ImageMetadata;
    desc2: string;
}

const {image1, desc1, image2, desc2 } =Astro.props
---

<div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-x-5 pt-5 pb-40">
    {image1 && (
        <div class="flex flex-col gap-1">
            <Image 
            src={image1} 
            alt={desc1} 
            class="w-full aspect-square object-cover"
            widths={[800, 1200, 1600, 2000, 2400, 3000]}
            sizes="(max-width: 768px) 100vw, 50vw"
            />
            <p class="text-sm uppercase opacity-50">{desc1}</p>
        </div>
    )}
    
    {image2 && (
      <div class="flex flex-col gap-1">
        <Image 
        src={image2} 
        alt={desc2} 
        class="w-full aspect-square object-cover"
        widths={[800, 1200, 1600, 2000, 2400, 3000]}
        sizes="(max-width: 768px) 100vw, 50vw"
        />
        <p class="text-sm uppercase opacity-50">{desc2}</p>
    </div>  
    )}
    

</div>