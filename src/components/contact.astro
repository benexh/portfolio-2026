---
import Divider from "./divider.astro"
---

<section class="relative h-screen mx-auto px-5 flex flex-col justify-center overflow-hidden">
    
    

    <div class="flex w-full flex-col md:flex-row md:justify-between items-start md:items-center max-w-3xl flex-1 mx-auto gap-10">

        
        <li class="list-none">
            <a href="https://www.linkedin.com/in/benedikt-hofmann-b22775294/" target="_blank" rel="noopener noreferrer" class="group text-base font-normal uppercase inline-flex items-baseline">

                LinkedIn
                    
                    <span class="inline-block -translate-x-2 opacity-0 group-hover:translate-x-2 group-hover:opacity-100 transition-all duration-150 overflow-hidden font-light">↗</span>
                
            </a>
        </li>

        <li class="list-none">
            <a href="https://www.instagram.com/studio_hb._?igsh=MWtzaDRjZDE5NTBmeg%3D%3D&utm_source=qr" target="_blank" rel="noopener noreferrer" class="group text-base font-normal uppercase inline-flex items-baseline">

                Instagram
                    
                    <span class="inline-block -translate-x-2 opacity-0 group-hover:translate-x-2 group-hover:opacity-100 transition-all duration-150 overflow-hidden font-light">↗</span>
                
            </a>
        </li>

        <li class="list-none">
            <a href="mailto:hello@hofmann-benedikt.de" class="group text-base font-normal uppercase inline-flex items-baseline">

                Email
                    
                    <span class="inline-block -translate-x-2 opacity-0 group-hover:translate-x-2 group-hover:opacity-100 transition-all duration-150 overflow-hidden font-light">↗</span>
                
            </a>
        </li>

        <li class="list-none">
            <a href="/CV_Benedikt-Hofmann_EN_2026.pdf" target="_blank" rel="noopener noreferrer" class="group text-base font-normal uppercase inline-flex items-baseline">

                Resume
                    
                    <span class="inline-block -translate-x-2 opacity-0 group-hover:translate-x-2 group-hover:opacity-100 transition-all duration-150 overflow-hidden font-light">↗</span>
                
            </a>
        </li>
       
    </div>

    <p class="absolute -bottom-10 left-1/2 -translate-x-1/2 
            text-[20rem] font-semibold leading-none whitespace-nowrap
            bg-linear-to-t from-background/0 from-0% via-background/30 via-15% via-[var(--gradient-color)]/20 via-35% to-[var(--gradient-color)]/80
            bg-clip-text text-transparent select-none [font-variation-settings:'ROND'_20]">HOFMANN</p>
</section>

<script>
    const colors = [
        '#FF6ECC',
        '#FF0000',
        '#6B0021',
        '#00A6FF',
        '#AEE8FF',
        '#FF7E00',
        '#FFF100',
        '#00A900'
    ];

    const randomColor = colors[Math.floor(Math.random()* colors.length)];

    document.documentElement.style.setProperty('--gradient-color', randomColor);
</script>