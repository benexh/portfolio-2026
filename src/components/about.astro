---
import { Image } from "astro:assets";
import portrait from "../assets/images/hero/PortraitBW.webp";
import Divider from "./divider.astro";
import smartbrokerLogo from "../assets/images/about/S+logo2.webp"
import fhpLogoDark from "../assets/images/about/FHPLogoDark.webp"
import fhpLogoLight from "../assets/images/about/FHPLogoLight.webp"
---

<section class="relative h-[75vh] flex flex-col justify-center mx-auto max-w-3xl px-5">
    <Divider 
        label="Experience"
    />

    <div class="flex justify-between items-start border-b border-border-quite py-8">

        <div class="flex items-center gap-4">
            <Image 
                src={smartbrokerLogo}
                alt="Smartbroker+"
                class="h-4 w-4 object-contain"
            />
            <p class="text-sm">SMARTBROKER+</p>
        </div>
        

        <div class="w-1/2 flex flex-col">
            <p class="text-sm">Product Design Internship / Working Student</p>
            <p class="text-sm text-text-muted">Jun 2026 - Present</p>
        </div>
    </div>

    <div class="flex justify-between items-start border-b border-border-quite py-8">
        <div class="flex items-center gap-4">
            <Image 
                src={fhpLogoLight}
                alt="FHPLogo"
                class="h-4 w-4 object-contain dark:hidden"
            />

            <Image
                src={fhpLogoDark}
                alt="FHPLogo"
                class="hidden h-4 w-4 object-contain dark:block"
            />
            <p class="text-sm">Fachhochschule Potsdam+</p>
        </div>

        <div class="w-1/2 flex flex-col">
            <p class="text-sm">Student Assistant for 3D-Print</p>
            <p class="text-sm text-text-muted">May 2025 - Jun 2026</p>
        </div>
    </div>

    <div class="flex justify-between border-b items-start border-border-quite py-8">
        <div class="flex items-center gap-4">
            <Image 
                src={fhpLogoLight}
                alt="FHPLogo"
                class="h-4 w-4 object-contain dark:hidden"
            />

            <Image
                src={fhpLogoDark}
                alt="FHPLogo"
                class="hidden h-4 w-4 object-contain dark:block"
            />
            <p class="text-sm">Fachhochschule Potsdam+</p>
        </div>

        <div class="w-1/2 flex flex-col">
            <p class="text-sm">Bachelor of Arts Interfacedesign</p>
            <p class="text-sm text-text-muted">Oct 2023 - Present</p>
        </div>
    </div>

    
</section>