---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  title: string;
  description: string;
  context: string;
  year: string;
  collaborators: string[];
  type: string[];
  tools: string[];
}

const { image, title, description, context, year, collaborators, type, tools } = Astro.props;

import ProjectInfo from '../components/projectinfo.astro';
---

<section class="w-full min-h-screen">
    <div class="w-full aspect-square md:aspect-1512/650">
        <Image 
          src={image}
          alt=""
          class="w-full h-full object-cover"
          loading={'eager'}
          fetchpriority={'high'}
          widths={[800, 1200, 1600, 2000, 2400, 3000]}
          sizes="100vw"
        />
    </div>

    <div class="flex flex-col px-5 gap-10 pt-8 md:pt-16">
        <div>
            <h1 class="text-2xl md:text-5xl uppercase font-normal">{title}</h1>
        </div>

        <div class="flex flex-col gap-5 md:flex-row flex-wrap md:gap-36 max-w-6xl">
            <ProjectInfo 
                label="Year"
                content={year}
            />

            <ProjectInfo 
                label="Context"
                content={context}
            />

            <ProjectInfo 
                label="Collaborators"
                content={collaborators}
            />

            <ProjectInfo 
                label="Tools"
                content={tools}
            />

            <ProjectInfo 
                label="Area"
                content={type}
            />
        </div>
    </div>
</section>