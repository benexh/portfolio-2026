---
import type { ImageMetadata } from 'astro';

interface ContentBlock {
    type: 'imageText' | 'imageRow' | 'wideImage' | 'divider' | 'video' | 'videoText';
    image?: ImageMetadata;
    description?: string;
    caption?: string;
    captionlabel?: string;
    image1?: ImageMetadata;
    desc1?: string;
    image2?: ImageMetadata;
    desc2?: string;
    desc?: string;
    label?: string;
    videoId?: string;
    video?: string;
    poster?: ImageMetadata;
}

interface Props {
  description: string;

  firstBlock: {
    image: ImageMetadata;
    caption: string;
  };

  contentBlocks?: ContentBlock[];

  insights?: string;
  
}

const { description, insights, firstBlock, contentBlocks} = Astro.props;
import Divider from './divider.astro';
import Imgtextrow from './imgtextrow.astro';
import Textrow from './textrow.astro';
import Imgimgrow from './imgimgrow.astro';
import Wideimgrow from './wideimgrow.astro';
import Widevidrow from './widevidrow.astro';
import Vidtextrow from './vidtextrow.astro';
---

<section class="relative px-5">
    <Divider />
    
    <Imgtextrow 
        description={description}
        image1={firstBlock.image}
        captionlabel="Project Summary"
        desc1={firstBlock.caption}
    />

    <Divider />

    {contentBlocks?.map((block) => (
        <>
            {block.type === 'imageText' && (
                <Imgtextrow
                    description={block.description || ''}
                    captionlabel={block.captionlabel || ''}
                    image1={block.image}
                    desc1={block.caption || ''}
                />
            )}

            {block.type === 'imageRow' && (
                <Imgimgrow
                    image1={block.image1}
                    desc1={block.desc1 || ''}
                    image2={block.image2}
                    desc2={block.desc2 || ''}
                />
            )}

            {block.type === 'wideImage' && (
                <Wideimgrow 
                    image={block.image}
                    desc={block.desc || ''}
                />
            )}

            {block.type === 'divider' && (
                <Divider label={block.label} />
            )}

            {block.type === 'video' && (
                <Widevidrow 
                    videoId={block.videoId || ''}
                    desc={block.desc || ''}
                />
            )}

            {block.type === 'videoText' && (
                <Vidtextrow
                    description={block.description || ''}
                    captionlabel={block.captionlabel || ''}
                    video={block.video || ''}
                    desc1={block.desc1 || ''}
                    poster={block.poster}
                />
            )}
        </>
    ))}

    {insights && (
        <Textrow
            insights={insights}
        />
    )}


    <div class="pb-28">
        <a href="/#projects">
            <Divider 
                label="← Back to projects"
            />
        </a>
        
    </div>
    
</section>