---
interface Props {
    projectTitle?: string;
    pageTitle?: string;
}

const {projectTitle, pageTitle} = Astro.props; 
---

<nav class="fixed bg-linear-to-b from-background to-transparent top-0 left-0 z-50 w-full">
    <div class="flex justify-between items-center px-5 md:px-11 py-5">
        <a href="/" class="flex-1 text-left uppercase text-nav whitespace-nowrap">
            Benedikt Hofmann ©2026
        </a>
        
        <div class="hidden md:block absolute left-1/2 -translate-x-1/2 text-center uppercase text-nav whitespace-nowrap">
            {projectTitle 
            ?  `/ projects / ${projectTitle}`
            : pageTitle
            ? `${pageTitle}`
            : 'Home'} 
        </div>
        <div class="flex-1 text-right uppercase text-nav">
            <span class="md:hidden">Product Designer</span>
            <span id="current-time" class="hidden md:inline">Potsdam / GER:</span>
        </div>
    </div>
</nav>

<script>
    const updateTime = () => {
        const currentTime = new Date().toLocaleTimeString('de-DE', {
            hour: '2-digit',
            minute: '2-digit',  
            timeZone: 'Europe/Berlin'
        });

        const element = document.getElementById('current-time');
        
        if (element) {
            element.textContent = `Potsdam / GER: ${currentTime}`;
        }
    };

    updateTime();
    setInterval(updateTime, 1000);
</script>