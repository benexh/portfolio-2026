---
interface Props {
    projectTitle?: string;
    pageTitle?: string;
}

const {projectTitle, pageTitle} = Astro.props; 
---

<nav class="fixed bg-white top-0 left-0 z-50 w-full">
    <div class="flex justify-between items-center px-5 py-4">
        <a href="/" class="flex-1 text-left uppercase text-nav whitespace-nowrap">
            Benedikt Hofmann ©2026
        </a>
        
        <div class="hidden md:block absolute left-1/2 -translate-x-1/2 text-center uppercase text-nav whitespace-nowrap">
            {projectTitle 
            ?  `/ projects / ${projectTitle}`
            : pageTitle
            ? `${pageTitle}`
            : 'Home'} 
        </div>
        <div class="flex-1 text-right uppercase text-nav">
            <span class="md:hidden">Product Designer</span>
            <span class="hidden md:inline">Product Designer / Potsdam Germany</span>
        </div>
    </div>
</nav>