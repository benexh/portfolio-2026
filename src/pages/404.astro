---
import Layout from "../layouts/Layout.astro";
import Divider from "../components/divider.astro";
---

<Layout title="404 - Page not found" pageTitle="404">
    <div class="min-h-screen flex flex-col px-5 pt-32">
        
        <div class="flex-1 flex flex-col justify-center items-center gap-5">
            
          <h1 class="text-2xl md:text-4xl font-normal uppercase text-center">404 Page Not Found</h1>
          <p class="text-xl opacity-50 max-w-md text-center">
            The page you're looking for doesn't exist or has been moved.
          </p>
          <a href="/" class="text-sm uppercase hover:opacity-60 transition-opacity mt-8">
            ← Return Home
          </a>
        </div>
      </div>
</Layout>
